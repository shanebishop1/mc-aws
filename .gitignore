# local mock state
/.local-artifacts/
/.local-artifacts/mock-state.json
/.local-artifacts/mock-state.json.lock
/.local-artifacts/mock-state.json.lock.recovery
/.local-artifacts/mock-state.json.*.tmp
# Legacy path is ignored only to avoid indexing existing developer data. Build
# preparation fails closed if it is present and never removes it implicitly.
/.mock-state.json
/.mock-state.json.lock
/.mock-state.json.lock.recovery
/.mock-state.json.*.tmp

# non-secret local deployment ownership state
.mc-aws-deployment.json
.mc-aws-deployment.json.cloudflare-recovery.json*
.mc-aws-host-upgrade.json

# local configuration
mise.local.toml
/server-profile/

# local e2e artifacts
tests/*-output.txt
tests/*-results.txt

# env files - using parent directory .env
.env*
!.env.example
!.env.local.example
!.env.production.example
!.env.mock.example

# vercel
.vercel

