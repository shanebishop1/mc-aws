{
  "schemaVersion": 1,
  "extensionId": "mc-aws.example.status-report",
  "version": "1.0.0",
  "compatibility": {
    "contractSchemaVersions": [1],
    "platforms": ["mc-aws-agent"]
  },
  "provenance": {
    "source": "mc-aws",
    "reference": "examples/agent-extensions/status-report/extension.json",
    "integrity": "sha256:ddf3ad8c4458ecf5c9f591e4ffebbe9a0a003576529fff505d9b5c5f47dc735a"
  },
  "tools": [
    {
      "schemaVersion": 1,
      "toolId": "example.status-report.read",
      "displayName": "Read server status inputs",
      "description": "Reads one operator-selected status file inside the mounted Minecraft workspace.",
      "capability": "workspace.read",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string" },
          "maxBytes": { "type": "integer", "minimum": 1 }
        }
      }
    }
  ],
  "skills": [
    {
      "schemaVersion": 1,
      "skillId": "mc-aws.example.status-report",
      "version": "1.0.0",
      "displayName": "Minecraft status report",
      "description": "Summarizes selected workspace status files without changing the server.",
      "compatibility": {
        "contractSchemaVersions": [1],
        "platforms": ["mc-aws-agent"]
      },
      "instructions": "Read only operator-selected workspace-relative files. Cite evidence, do not mutate state, and do not request credentials, host paths, metadata, cloud APIs, deployment, or provider secrets.",
      "resources": ["SKILL.md"],
      "requestedTools": ["example.status-report.read"],
      "provenance": {
        "source": "mc-aws",
        "reference": "examples/agent-extensions/status-report/extension.json",
        "integrity": "sha256:ddf3ad8c4458ecf5c9f591e4ffebbe9a0a003576529fff505d9b5c5f47dc735a"
      }
    }
  ],
  "hooks": [
    {
      "schemaVersion": 1,
      "hookId": "mc-aws.example.status-report.evidence",
      "hookPoint": "after-invocation",
      "priority": 500,
      "failureBehavior": "fail-closed",
      "handlerRef": "mc-aws.record-read-evidence"
    }
  ]
}
