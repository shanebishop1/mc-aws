# Local AWS development template
# Copy to .env.local when you want to run the panel locally against real AWS.
# For offline development, use .env.mock.example instead.

# Local API routes use the normal AWS SDK credential chain. Authenticate with
# AWS SSO / ~/.aws/config, or a local credential profile. Never copy human AWS
# credentials into the production Worker deployment file.
AWS_REGION=us-west-1
# Setup-managed immutable infrastructure input (not a secret).
AL2023_ARM64_AMI_ID=
# Setup persists the validated config/bootstrap-pins.json SHA-256 here.
MC_BOOTSTRAP_PINS_SHA256=
INSTANCE_ID=i-1234567890abcdef0
# Copy these CloudFormation outputs from setup for real-AWS lifecycle operations.
MC_LIFECYCLE_LOCK_TABLE_NAME=
MC_OPERATION_STATE_TABLE_NAME=

# Optional local outbound agent runtime pair. Do not put a production bearer here.
MC_AGENT_RUNTIME_ENABLED=false
MC_AGENT_RUNTIME_ID=
MC_AGENT_RUNTIME_TOKEN_SHA256=
# Canonical base64 PKCS#8 Ed25519 private key; only its public half enters EC2.
MC_AGENT_BACKUP_FENCE_PRIVATE_KEY_PKCS8=
# Public executor terminal-receipt verifier set; setup manages the production value.
MC_AGENT_EXECUTOR_RECEIPT_VERIFIERS=
MC_AGENT_RUNTIME_TOKEN=
# Optional credential-free local catalog. Use the same exact JSON shapes documented
# in docs/API.md; credential references and provider secrets are forbidden here.
MC_AGENT_PUBLIC_PROVIDER_CATALOG=
MC_AGENT_RUNTIME_PROVIDER_PROFILES=

# Local auth and panel URL
# pnpm dev already enables ENABLE_DEV_LOGIN=true for convenience.
# This intentionally convenient value is accepted only outside production.
AUTH_SECRET=dev-secret-change-in-production
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=your-email@gmail.com
ALLOWED_EMAILS=friend1@gmail.com,friend2@gmail.com

# Setup/deployment mode metadata (the panel choice is independent of Minecraft DNS)
PANEL_HOSTING_MODE=custom
PANEL_DNS_MANAGEMENT=managed
PANEL_WORKERS_DEV_ENABLED=false
CLOUDFLARE_WORKERS_SUBDOMAIN=
CLOUDFLARE_PANEL_ZONE_ID=your-panel-zone-id
CLOUDFLARE_PANEL_DNS_API_TOKEN=your-panel-dns-api-token

# Optional Google OAuth for local sign-in (dev login also works)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required for start/resume flows that update Minecraft DNS
MC_CONNECTION_MODE=cloudflare
CLOUDFLARE_DNS_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-zone-id
# Optional legacy record ID; new deployments resolve the record by hostname.
CLOUDFLARE_RECORD_ID=
CLOUDFLARE_MC_DOMAIN=mc.yourdomain.com

# Optional operations features
MC_OPERATION_STATE_RETENTION_DAYS=30
SES_NOTIFICATIONS_ENABLED=false
SES_INBOUND_COMMANDS_ENABLED=false
VERIFIED_SENDER=
NOTIFICATION_EMAIL=
SES_INBOUND_RECIPIENT=
SES_RECEIPT_RULE_SET_NAME=
START_KEYWORD=
MC_ALARM_EMAIL=
GDRIVE_REMOTE=gdrive
GDRIVE_ROOT=mc-backups
MC_SCHEDULED_BACKUP_ENABLED=false
MC_SCHEDULED_BACKUP_SCHEDULE=cron(0 5 ? * SUN *)
MC_BACKUP_STALE_AFTER_HOURS=192
