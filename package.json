{
  "name": "mc-aws-frontend",
  "version": "0.2.3",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "22.15.1",
    "pnpm": "10.30.3"
  },
  "scripts": {
    "clean": "tsx scripts/operations/clean-local-artifacts.ts all",
    "clean:build": "tsx scripts/operations/clean-local-artifacts.ts build",
    "clean:next": "tsx scripts/operations/clean-local-artifacts.ts next",
    "clean:test": "tsx scripts/operations/clean-local-artifacts.ts test",
    "clean:cdk": "tsx scripts/operations/clean-local-artifacts.ts cdk",
    "clean:store": "pnpm store prune",
    "predev": "pnpm clean:build",
    "dev": "mkdir -p .local-artifacts/build-tmp && TMPDIR=\"$PWD/.local-artifacts/build-tmp\" ENABLE_DEV_LOGIN=true next dev -p 3000",
    "predev:mock": "pnpm clean:build",
    "dev:mock": "mkdir -p .local-artifacts/build-tmp && TMPDIR=\"$PWD/.local-artifacts/build-tmp\" MC_BACKEND_MODE=mock ENABLE_DEV_LOGIN=true next dev -p 3000",
    "setup": "./setup.sh",
    "doctor": "tsx scripts/validation/doctor.ts",
    "repo:doctor": "tsx scripts/validation/doctor.ts",
    "env:check:local": "tsx scripts/validation/validate-env.ts --target local-dev",
    "env:check:worker": "tsx scripts/validation/validate-env.ts --target worker --env-file .env.production",
    "env:check:ci": "tsx scripts/validation/validate-env.ts --target ci --strict",
    "prebuild": "pnpm clean:next && tsx scripts/validation/validate-env.ts",
    "build": "mkdir -p .local-artifacts/build-tmp && TMPDIR=\"$PWD/.local-artifacts/build-tmp\" next build",
    "build:production:check": "rm -rf .next && env MC_BACKEND_MODE=aws ENABLE_DEV_LOGIN= AUTH_SECRET=ci-only-auth-secret-not-used-outside-builds ADMIN_EMAIL=ci@example.invalid GOOGLE_CLIENT_ID=ci-client-id GOOGLE_CLIENT_SECRET=ci-client-secret NEXT_PUBLIC_APP_URL=https://ci.example.invalid MC_LIFECYCLE_LOCK_TABLE_NAME=ci-lifecycle-lock-table MC_OPERATION_STATE_TABLE_NAME=ci-operation-state-table pnpm build",
    "start": "next start",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check --error-on-warnings . && pnpm lambda:check",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "lambda:check": "tsc -p infra/src/lambda/StartMinecraftServer/tsconfig.check.json",
    "lambda:assets:audit": "tsx scripts/validation/audit-lambda-assets.ts",
    "server:status": "tsx scripts/operations/server-cli.ts status",
    "server:start": "tsx scripts/operations/server-cli.ts start",
    "server:stop": "tsx scripts/operations/server-cli.ts stop",
    "server:hibernate": "tsx scripts/operations/server-cli.ts hibernate",
    "server:resume": "tsx scripts/operations/server-cli.ts resume",
    "server:backup": "tsx scripts/operations/server-cli.ts backup",
    "server:restore": "tsx scripts/operations/server-cli.ts restore",
    "server:backups": "tsx scripts/operations/server-cli.ts backups",
    "profile:init": "tsx scripts/setup/server-profile.ts init",
    "profile:validate": "tsx scripts/setup/server-profile.ts validate",
    "profile:rollout:check": "tsx scripts/setup/server-profile.ts rollout-check",
    "operations:cleanup": "tsx scripts/operations/cleanup-operation-state.ts",
    "pretest": "pnpm clean:test",
    "test": "mkdir -p .local-artifacts/test-tmp && TMPDIR=\"$PWD/.local-artifacts/test-tmp\" vitest run",
    "pretest:watch": "pnpm clean:test",
    "test:watch": "mkdir -p .local-artifacts/test-tmp && TMPDIR=\"$PWD/.local-artifacts/test-tmp\" vitest",
    "pretest:coverage": "pnpm clean:test",
    "test:coverage": "mkdir -p .local-artifacts/test-tmp && TMPDIR=\"$PWD/.local-artifacts/test-tmp\" vitest run --coverage",
    "pretest:mock": "pnpm clean:test",
    "test:mock": "mkdir -p .local-artifacts/test-tmp && TMPDIR=\"$PWD/.local-artifacts/test-tmp\" MC_BACKEND_MODE=mock vitest run",
    "pretest:e2e": "pnpm clean:test",
    "test:e2e": "mkdir -p .local-artifacts/test-tmp && TMPDIR=\"$PWD/.local-artifacts/test-tmp\" playwright test",
    "pretest:e2e:mock": "pnpm clean:test",
    "test:e2e:mock": "mkdir -p .local-artifacts/test-tmp && TMPDIR=\"$PWD/.local-artifacts/test-tmp\" MC_BACKEND_MODE=mock playwright test --workers=1",
    "pretest:e2e:ui": "pnpm clean:test",
    "test:e2e:ui": "mkdir -p .local-artifacts/test-tmp && TMPDIR=\"$PWD/.local-artifacts/test-tmp\" playwright test --ui",
    "mock:reset": "tsx scripts/operations/mock-cli.ts reset",
    "mock:scenario": "tsx scripts/operations/mock-cli.ts scenario",
    "validate:dev-login": "MC_BACKEND_MODE=mock ENABLE_DEV_LOGIN=true tsx scripts/validation/validate-dev-login.ts",
    "docs:check": "tsx scripts/validation/validate-docs-consistency.ts",
    "release:prepare": "tsx scripts/release/prepare-release.ts",
    "prepreview:cf": "pnpm clean:build",
    "preview:cf": "mkdir -p .local-artifacts/opennext-tmp && TMPDIR=\"$PWD/.local-artifacts/opennext-tmp\" opennextjs-cloudflare build && TMPDIR=\"$PWD/.local-artifacts/opennext-tmp\" wrangler dev",
    "predeploy:cf": "pnpm clean:build",
    "deploy:cf": "./scripts/cloudflare/deploy-cloudflare.sh",
    "cdk:version": "cd infra && cdk --version",
    "precdk:list": "pnpm clean:cdk",
    "cdk:list": "CDK_TMP=\"$PWD/.local-artifacts/cdk-tmp\" && mkdir -p \"$CDK_TMP\" && cd infra && TMPDIR=\"$CDK_TMP\" cdk list",
    "precdk:synth": "pnpm clean:cdk",
    "cdk:synth": "CDK_TMP=\"$PWD/.local-artifacts/cdk-tmp\" && mkdir -p \"$CDK_TMP\" && cd infra && TMPDIR=\"$CDK_TMP\" cdk synth",
    "precdk:diff": "pnpm clean:cdk",
    "cdk:diff": "CDK_TMP=\"$PWD/.local-artifacts/cdk-tmp\" && mkdir -p \"$CDK_TMP\" && cd infra && TMPDIR=\"$CDK_TMP\" cdk diff",
    "precdk:deploy": "pnpm clean:cdk",
    "cdk:deploy": "tsx scripts/aws/deploy-cdk.ts",
    "ami:pin": "tsx scripts/setup/pin-al2023-ami.ts",
    "ami:upgrade": "tsx scripts/setup/pin-al2023-ami.ts",
    "dns:secrets:materialize": "tsx scripts/setup/materialize-dns-secrets.ts",
    "bootstrap:check": "tsx scripts/setup/pin-bootstrap-artifacts.ts check",
    "bootstrap:review": "tsx scripts/setup/pin-bootstrap-artifacts.ts review",
    "bootstrap:upgrade": "tsx scripts/setup/pin-bootstrap-artifacts.ts upgrade",
    "mise:review": "bash scripts/setup/bootstrap-mise.sh review",
    "mise:upgrade": "bash scripts/setup/bootstrap-mise.sh upgrade",
    "migrate:existing": "tsx scripts/aws/migrate-existing-deployment.ts",
    "host:upgrade": "tsx scripts/aws/upgrade-existing-host.ts",
    "cdk:destroy": "./scripts/operations/destroy.sh",
    "cdk:destroy:force": "./scripts/operations/destroy.sh --execute",
    "destroy": "./scripts/operations/destroy.sh",
    "destroy:force": "./scripts/operations/destroy.sh --execute",
    "destroy:execute": "./scripts/operations/destroy.sh --execute",
    "destroy:execute:snapshot": "./scripts/operations/destroy.sh --execute --retain-final-snapshot",
    "destroy:cleanup-local": "./scripts/operations/destroy.sh --execute --cleanup-local-env"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1095.0",
    "@aws-sdk/client-cost-explorer": "^3.1095.0",
    "@aws-sdk/client-dynamodb": "^3.1119.0",
    "@aws-sdk/client-ec2": "^3.1095.0",
    "@aws-sdk/client-lambda": "^3.1095.0",
    "@aws-sdk/client-ssm": "^3.1095.0",
    "@smithy/fetch-http-handler": "5.6.11",
    "@tanstack/react-query": "^5.90.21",
    "arctic": "^3.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.24.10",
    "jose": "^6.1.3",
    "next": "^15.5.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@aws-sdk/client-ses": "^3.1096.0",
    "@biomejs/biome": "^1.9.4",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "aws-cdk": "^2.1133.0",
    "aws-cdk-lib": "^2.262.1",
    "constructs": "^10.7.1",
    "dotenv": "^16.6.1",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.26",
    "source-map-support": "^0.5.21",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@isaacs/brace-expansion": ">=5.0.1",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "fast-xml-parser": "5.10.1",
      "minimatch@8.0.7": "10.2.6",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss": "8.5.26",
      "sharp": "0.35.3"
    }
  }
}
