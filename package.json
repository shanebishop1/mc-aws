{
  "name": "mc-aws-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "22.15.1",
    "pnpm": "10.30.3"
  },
  "scripts": {
    "dev": "ENABLE_DEV_LOGIN=true next dev -p 3000",
    "dev:mock": "MC_BACKEND_MODE=mock ENABLE_DEV_LOGIN=true next dev -p 3000",
    "setup": "./setup.sh",
    "doctor": "tsx scripts/doctor.ts",
    "repo:doctor": "tsx scripts/doctor.ts",
    "env:check:local": "tsx scripts/validate-env.ts --target local-dev",
    "env:check:worker": "tsx scripts/validate-env.ts --target worker --env-file .env.production",
    "env:check:ci": "tsx scripts/validate-env.ts --target ci --strict",
    "prebuild": "tsx scripts/validate-env.ts",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "server:status": "tsx scripts/server-cli.ts status",
    "server:start": "tsx scripts/server-cli.ts start",
    "server:stop": "tsx scripts/server-cli.ts stop",
    "server:hibernate": "tsx scripts/server-cli.ts hibernate",
    "server:resume": "tsx scripts/server-cli.ts resume",
    "server:backup": "tsx scripts/server-cli.ts backup",
    "server:restore": "tsx scripts/server-cli.ts restore",
    "server:backups": "tsx scripts/server-cli.ts backups",
    "operations:cleanup": "tsx scripts/cleanup-operation-state.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mock": "MC_BACKEND_MODE=mock vitest run",
    "test:e2e": "playwright test",
    "test:e2e:mock": "MC_BACKEND_MODE=mock playwright test --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "mock:reset": "tsx scripts/mock-cli.ts reset",
    "mock:scenario": "tsx scripts/mock-cli.ts scenario",
    "validate:dev-login": "MC_BACKEND_MODE=mock ENABLE_DEV_LOGIN=true tsx scripts/validate-dev-login.ts",
    "docs:check": "tsx scripts/validate-docs-consistency.ts",
    "preview:cf": "opennextjs-cloudflare build && wrangler dev",
    "deploy:cf": "./scripts/deploy-cloudflare.sh",
    "cdk:version": "cd infra && cdk --version",
    "cdk:list": "cd infra && cdk list",
    "cdk:synth": "cd infra && cdk synth",
    "cdk:diff": "cd infra && cdk diff",
    "cdk:deploy": "cd infra && cdk deploy",
    "cdk:destroy": "./scripts/destroy.sh",
    "cdk:destroy:force": "./scripts/destroy.sh --execute",
    "destroy": "./scripts/destroy.sh",
    "destroy:force": "./scripts/destroy.sh --execute",
    "destroy:execute": "./scripts/destroy.sh --execute",
    "destroy:cleanup-local": "./scripts/destroy.sh --execute --cleanup-local-env"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1095.0",
    "@aws-sdk/client-cost-explorer": "^3.1095.0",
    "@aws-sdk/client-ec2": "^3.1095.0",
    "@aws-sdk/client-lambda": "^3.1095.0",
    "@aws-sdk/client-ssm": "^3.1095.0",
    "@smithy/fetch-http-handler": "5.6.11",
    "@tanstack/react-query": "^5.90.21",
    "arctic": "^3.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.24.10",
    "jose": "^6.1.3",
    "next": "^15.5.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@aws-sdk/client-ses": "^3.1096.0",
    "@biomejs/biome": "^1.9.4",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "aws-cdk": "^2.1133.0",
    "aws-cdk-lib": "^2.262.1",
    "constructs": "^10.7.1",
    "dotenv": "^16.6.1",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.18",
    "source-map-support": "^0.5.21",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@isaacs/brace-expansion": ">=5.0.1",
      "fast-xml-parser": "5.10.1",
      "minimatch@8.0.7": "10.2.6",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  }
}
