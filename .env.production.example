# Production deployment template
# Copy to .env.production and fill in real values before running ./setup.sh or pnpm deploy:cf.

# AWS runtime metadata. Setup creates dedicated runtime credentials and pipes
# them directly to Wrangler; never place human/deployment AWS keys in this file.
AWS_REGION=us-west-1
AWS_COST_EXPLORER_ENABLED=true

# AWS deploy metadata
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-west-1
# Setup resolves, validates, and persists this exact ARM64 AL2023 AMI. Do not
# change it during routine deploys; use the reviewed `pnpm ami:upgrade` workflow.
AL2023_ARM64_AMI_ID=
# Setup persists the validated config/bootstrap-pins.json SHA-256 here.
MC_BOOTSTRAP_PINS_SHA256=
INSTANCE_ID=i-1234567890abcdef0
# Setup populates these CloudFormation outputs after the stack is deployed.
MC_LIFECYCLE_LOCK_TABLE_NAME=
MC_OPERATION_STATE_TABLE_NAME=
# Outbound agent runtime Worker verifier. The raw bearer must not be stored in
# this deploy file; inject MC_AGENT_RUNTIME_TOKEN only into the EC2 gateway.
# Keep false until all six identity/signing/verifier/catalog/profile values below are reviewed and
# complete. Every deploy uploads this switch, so false invalidates retained bearers.
MC_AGENT_RUNTIME_ENABLED=false
MC_AGENT_RUNTIME_ID=
MC_AGENT_RUNTIME_TOKEN_SHA256=
# Canonical base64 PKCS#8 Ed25519 private key. The Worker signs exact backup
# fences; deployment derives and provisions only its public half to EC2.
MC_AGENT_BACKUP_FENCE_PRIVATE_KEY_PKCS8=
# Setup-managed exact JSON verifier set for executor-signed terminal receipts.
# Contains public SPKI material only and retains at most three rotation keys.
MC_AGENT_EXECUTOR_RECEIPT_VERIFIERS=
# Strict JSON public catalog (no credentialRef/key) and strict full metadata inventory
# generated from the reviewed EC2 gateway profiles. Startup/API use fails closed
# unless every canonical profile field matches exactly; ID-only inventories are rejected.
# Example values (keep each JSON value on one line):
# MC_AGENT_PUBLIC_PROVIDER_CATALOG='{"schemaVersion":1,"profiles":[{"schemaVersion":1,"profileId":"reviewed-provider","providerId":"reviewed-openai-api","providerKind":"openai-compatible","displayName":"Reviewed provider","endpoint":"https://provider.example.com/v1","allowedModels":["reviewed-model"],"supportedFeatures":["streaming","tools"]}]}'
# MC_AGENT_RUNTIME_PROVIDER_PROFILES='{"schemaVersion":1,"profiles":[{"schemaVersion":1,"profileId":"reviewed-provider","providerId":"reviewed-openai-api","providerKind":"openai-compatible","displayName":"Reviewed provider","endpoint":"https://provider.example.com/v1","allowedModels":["reviewed-model"],"supportedFeatures":["streaming","tools"]}]}'
MC_AGENT_PUBLIC_PROVIDER_CATALOG=
MC_AGENT_RUNTIME_PROVIDER_PROFILES=
# Optional key-pair association; SSH ingress remains closed by default.
KEY_PAIR_NAME=

# Google OAuth
GOOGLE_CLIENT_ID=123456789-abcdefg.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-abc123xyz789

# Auth and panel config
ADMIN_EMAIL=your-email@gmail.com
ALLOWED_EMAILS=friend1@gmail.com,friend2@gmail.com
PANEL_HOSTING_MODE=custom
# managed (default) lets deploy read/write panel DNS; external preserves DNS without API access.
PANEL_DNS_MANAGEMENT=managed
# For managed custom hosting, set panel DNS credentials separately from Minecraft DNS.
PANEL_WORKERS_DEV_ENABLED=false
CLOUDFLARE_PANEL_ZONE_ID=your-panel-zone-id
CLOUDFLARE_PANEL_DNS_API_TOKEN=your-panel-dns-api-token
# For workers.dev hosting instead, set PANEL_HOSTING_MODE=workers_dev, leave
# PANEL_DNS_MANAGEMENT empty, and enter
# either account-name.workers.dev or the full expected Worker URL here. Setup
# derives NEXT_PUBLIC_APP_URL using the Worker name.
CLOUDFLARE_WORKERS_SUBDOMAIN=
NEXT_PUBLIC_APP_URL=https://panel.yourdomain.com
# Setup generates canonical unpadded base64url from 48 random bytes. AUTH_SECRET
# is never supplied to Next.js/OpenNext build dotenv; deploy uploads it only as
# a runtime Worker secret binding. Direct deploy rejects this placeholder and
# every legacy/noncanonical value. Use explicit MC_AWS_ROTATE_AUTH_SECRET=1 to
# generate/rotate without printing it.
AUTH_SECRET=your-secret-here
# Non-secret Worker runtime selector; production deploys accept only this value
# and emit it as Wrangler vars, never as a Worker secret.
MC_BACKEND_MODE=aws

# Cloudflare DNS runtime config
MC_CONNECTION_MODE=cloudflare
CLOUDFLARE_DNS_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-zone-id
# Optional legacy record ID; new deployments resolve the record by hostname.
CLOUDFLARE_RECORD_ID=
CLOUDFLARE_MC_DOMAIN=mc.yourdomain.com
# Alternatives: MC_CONNECTION_MODE=duckdns with DUCKDNS_DOMAIN + DUCKDNS_TOKEN,
# or MC_CONNECTION_MODE=raw_ip with all Minecraft DNS values empty.
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# Runtime-state KV ids
# Optional on first deploy: deploy script can create and persist these ids for you
RUNTIME_STATE_SNAPSHOT_KV_ID=
RUNTIME_STATE_SNAPSHOT_KV_PREVIEW_ID=

# Durable operation-state retention
MC_OPERATION_STATE_RETENTION_DAYS=30

# Optional SES capabilities (independent and disabled by default)
# Notifications require VERIFIED_SENDER + NOTIFICATION_EMAIL.
# Inbound commands require SES_INBOUND_RECIPIENT + an existing active rule set + START_KEYWORD.
SES_NOTIFICATIONS_ENABLED=false
SES_INBOUND_COMMANDS_ENABLED=false
VERIFIED_SENDER=
NOTIFICATION_EMAIL=
SES_INBOUND_RECIPIENT=
SES_RECEIPT_RULE_SET_NAME=
START_KEYWORD=

# Optional CloudWatch/SNS operator alert destination. No subscription is created
# when blank. Confirm the AWS SNS email before alerts can be delivered.
MC_ALARM_EMAIL=

# Optional explicit profile path, including a subdirectory outside this worktree.
# Blank selects existing ignored server-profile/ first, then tracked config/.
MC_SERVER_PROFILE_DIR=
MC_ALLOW_EMPTY_WHITELIST=false

# Google Drive backups
GDRIVE_REMOTE=gdrive
GDRIVE_ROOT=mc-backups
# Explicit opt-in: setup cannot verify Drive authorization before deployment.
# Default schedule is Sunday 05:00 UTC and never starts stopped EC2 capacity.
MC_SCHEDULED_BACKUP_ENABLED=false
MC_SCHEDULED_BACKUP_SCHEDULE=cron(0 5 ? * SUN *)
MC_BACKUP_STALE_AFTER_HOURS=192
