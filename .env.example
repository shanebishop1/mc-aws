# Environment Configuration (combined compatibility reference)
# Preferred templates:
#   - .env.local.example       -> local AWS development
#   - .env.production.example  -> production deploy/runtime
#   - .env.mock.example        -> offline mock-mode development
# This file remains as a combined reference for older workflows.

# AWS Configuration. Local development/deployment uses the normal AWS CLI/SDK
# credential chain. Dedicated Worker credentials are never stored in env files;
# setup creates them and pipes them directly to Wrangler.
AWS_REGION=us-west-1
AWS_COST_EXPLORER_ENABLED=true
# Setup-managed immutable infrastructure/bootstrap inputs (not secrets).
AL2023_ARM64_AMI_ID=
MC_BOOTSTRAP_PINS_SHA256=
# Setup populates these CloudFormation outputs after the stack is deployed.
MC_LIFECYCLE_LOCK_TABLE_NAME=
MC_OPERATION_STATE_TABLE_NAME=

# Outbound agent runtime identity. The panel/Worker receives only this verifier;
# the raw bearer is provisioned separately into the gateway secret boundary. This
# canonical switch is required on every Worker deploy; false safely decommissions
# runtime authorization even if old identity secrets are still retained remotely.
MC_AGENT_RUNTIME_ENABLED=false
MC_AGENT_RUNTIME_ID=
MC_AGENT_RUNTIME_TOKEN_SHA256=
# Canonical base64 PKCS#8 Ed25519 private key; only its public half enters EC2.
MC_AGENT_BACKUP_FENCE_PRIVATE_KEY_PKCS8=
# Setup-managed public verifier set for executor-signed terminal receipts.
MC_AGENT_EXECUTOR_RECEIPT_VERIFIERS=
# Public, credential-free provider catalog used by the admin Agent UI. Production
# requires the separately generated full runtime profile metadata inventory to match exactly.
# See .env.production.example and docs/API.md for the strict single-line JSON shape.
MC_AGENT_PUBLIC_PROVIDER_CATALOG=
MC_AGENT_RUNTIME_PROVIDER_PROFILES=

# AWS CDK (optional, usually auto-detected)
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-west-1

# Google OAuth
# Get these from: docs/setup/GOOGLE_OAUTH_SETUP.md
# Copy these exact values printed by setup into the Google OAuth Web client:
#   Authorized JavaScript origin: <exact-panel-origin>
#   Sign-in redirect URI: <exact-panel-origin>/api/auth/callback
#   Google Drive redirect URI: <exact-panel-origin>/api/gdrive/callback
GOOGLE_CLIENT_ID=123456789-abcdefg.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-abc123xyz789

# Authentication & Authorization
# Admin user (full access)
ADMIN_EMAIL=your-email@gmail.com

# Allowed users (can start server, view status)
ALLOWED_EMAILS=friend1@gmail.com,friend2@gmail.com

# Production Settings
# For local development, these are set automatically by package.json scripts
# For production, you MUST set these:

# Your production control-panel URL (REQUIRED for production)
NEXT_PUBLIC_APP_URL=https://panel.yourdomain.com

# JWT signing secret. Setup writes canonical unpadded base64url for 48 random bytes.
# Production rejects all hand-written, padded, hex, and legacy values; explicitly
# rotate with MC_AWS_ROTATE_AUTH_SECRET=1 rather than converting an old value.
AUTH_SECRET=your-secret-here

# Cloudflare DNS
# For auto-updating Minecraft server IP when instance starts
# Cloudflare DNS API token (renamed from CLOUDFLARE_API_TOKEN to avoid wrangler auth collision)
CLOUDFLARE_DNS_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-zone-id
# Optional legacy record ID. Leave blank for a new setup; the record is found by hostname.
CLOUDFLARE_RECORD_ID=
CLOUDFLARE_MC_DOMAIN=mc.yourdomain.com

# Runtime-state Cloudflare KV namespace IDs (used by deploy script)
# Optional on first deploy: scripts/cloudflare/deploy-cloudflare.sh can create and persist these for you.
RUNTIME_STATE_SNAPSHOT_KV_ID=
RUNTIME_STATE_SNAPSHOT_KV_PREVIEW_ID=

# Durable operation-state retention (optional)
# Deletes stale /minecraft/operations/* records older than this many days
# Default: 30
MC_OPERATION_STATE_RETENTION_DAYS=30

# Email Configuration (SES) - optional, disabled by default
# Outbound notifications require VERIFIED_SENDER and NOTIFICATION_EMAIL.
# Inbound commands require an explicitly named existing receipt rule set; the
# stack adds/removes only its own rule and never changes the active rule set.
SES_NOTIFICATIONS_ENABLED=false
SES_INBOUND_COMMANDS_ENABLED=false
VERIFIED_SENDER=
NOTIFICATION_EMAIL=
SES_INBOUND_RECIPIENT=
SES_RECEIPT_RULE_SET_NAME=
START_KEYWORD=

# CloudWatch alarms always publish to the project SNS topic. Leave blank to
# create no email subscription. A configured address must confirm AWS's email.
MC_ALARM_EMAIL=

# Optional explicit profile path, including a subdirectory outside this worktree.
# Blank selects existing ignored server-profile/ first, then tracked config/.
MC_SERVER_PROFILE_DIR=
MC_ALLOW_EMPTY_WHITELIST=false

# Google Drive Backups
GDRIVE_REMOTE=gdrive
GDRIVE_ROOT=mc-backups
# Disabled by default because folder settings do not prove Drive authorization.
# When explicitly enabled, the default runs Sundays at 05:00 UTC, only while EC2
# is already running, with an 8-day (192-hour) staleness alarm window.
MC_SCHEDULED_BACKUP_ENABLED=false
MC_SCHEDULED_BACKUP_SCHEDULE=cron(0 5 ? * SUN *)
MC_BACKUP_STALE_AFTER_HOURS=192

# Optional EC2 key-pair association only. It does not open SSH ingress.
KEY_PAIR_NAME=

# Notes:
# MC_BACKEND_MODE, ENABLE_DEV_LOGIN are set by package.json scripts:
#   - pnpm dev          → aws mode, dev login enabled, localhost
#   - pnpm dev:mock     → mock mode, dev login enabled, localhost
#   - pnpm deploy:cf    → aws mode, dev login disabled, uses NEXT_PUBLIC_APP_URL above
