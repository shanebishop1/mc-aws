[Unit]
Description=mc-aws root-owned executor authentication socket
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/mc-agent/executor.sock
FileDescriptorName=executor
SocketUser=root
SocketGroup=mc-agent
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true
Service=mc-agent-executor.service

[Install]
WantedBy=sockets.target
