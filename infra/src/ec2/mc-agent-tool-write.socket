[Unit]
Description=mc-aws credentialless staged-write shell runner socket
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/mc-agent/shell-write.sock
FileDescriptorName=shell-write
SocketUser=root
SocketGroup=mc-agent-executor-client
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true
Service=mc-agent-tool-write.service

[Install]
WantedBy=sockets.target
