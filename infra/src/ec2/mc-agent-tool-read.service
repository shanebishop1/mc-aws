[Unit]
Description=mc-aws credentialless read-only shell runner
After=systemd-tmpfiles-setup.service mc-agent-tool-read.socket
Requires=mc-agent-tool-read.socket

[Service]
Type=simple
User=mc-agent-tool
Group=mc-agent-tool
SupplementaryGroups=mc-agent-workspace
UMask=0077
RootDirectory=/opt/mc-agent/tool-read-root
WorkingDirectory=/workspace
ExecStart=/runtime/node-current/bin/node --disallow-code-generation-from-strings /runtime/current/shell-runner-cli.mjs --read-only
Restart=on-failure
RestartSec=2s
RuntimeMaxSec=20min
TimeoutStopSec=10s
TimeoutStopFailureMode=kill
KillMode=control-group
SendSIGKILL=yes
MemoryHigh=64M
MemoryMax=96M
TasksMax=32
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
NoExecPaths=/workspace /changes
ExecPaths=/runtime/current /runtime/node-current /toolchain/bin/sh
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateIPC=true
PrivateMounts=true
PrivateUsers=true
PrivateNetwork=true
DevicePolicy=closed
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
KeyringMode=private
RestrictNamespaces=true
SystemCallArchitectures=native
SystemCallFilter=~@mount @privileged @resources @reboot @swap @obsolete
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
BindReadOnlyPaths=/opt/minecraft/server:/workspace
BindReadOnlyPaths=/opt/mc-agent/current:/runtime/current
BindReadOnlyPaths=/opt/mc-agent/node-current:/runtime/node-current
BindReadOnlyPaths=/opt/mc-agent/toolchain:/toolchain
BindReadOnlyPaths=/usr/lib:/usr/lib
BindReadOnlyPaths=/usr/lib64:/usr/lib64
BindReadOnlyPaths=/lib64:/lib64
BindReadOnlyPaths=-/etc/mc-agent/shell-toolchain.json:/config/shell-toolchain.json
InaccessiblePaths=/root /home /etc/mc-agent /run /run/credentials /var/lib/mc-agent-executor /runtime/executor-root /runtime/tool-read-root /runtime/tool-write-root
