[Unit]
Description=mc-aws credentialless read-only shell runner socket
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/mc-agent/shell-read.sock
FileDescriptorName=shell-read
SocketUser=root
SocketGroup=mc-agent-executor-client
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true
Service=mc-agent-tool-read.service

[Install]
WantedBy=sockets.target
