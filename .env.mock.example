# Mock-mode local development template
# Copy to .env.local for offline development without AWS credentials.

MC_BACKEND_MODE=mock
ENABLE_DEV_LOGIN=true
AUTH_SECRET=dev-secret-change-in-production
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Persisted mock state is local-only and excluded from build tracing.
MC_MOCK_STATE_PATH=.local-artifacts/mock-state.json

# Optional mock auth metadata
ADMIN_EMAIL=dev@localhost
ALLOWED_EMAILS=
